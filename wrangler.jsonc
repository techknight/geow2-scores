{
  // One deployment is one group's score server.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geow2-scores",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      // Created on the first deploy when there is no database_id.
      "binding": "DB",
      "database_name": "geow2-scores",
      "migrations_dir": "migrations"
    }
  ],
  // GROUP_NAME (the group's name; "geow2 scores" when unset) and
  // ADMIN_SECRET are set in the dashboard (Settings, Variables and Secrets)
  // or asked for by the Deploy to Cloudflare button (.dev.vars.example);
  // deploys keep them.
  "keep_vars": true
}
